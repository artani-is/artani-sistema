# ---------------------------------------------------------------------------
# Plantilla de variables para el despliegue de producción.
#
#   cp .env.prod.example .env      (en el droplet, junto a docker-compose.prod.yml)
#
# Este archivo es una PLANTILLA y no contiene ningún valor real. El .env que
# generes a partir de él nunca debe subirse al repositorio.
# ---------------------------------------------------------------------------

# --- Dominio y certificado TLS ---------------------------------------------
# Dominio ya apuntado por DNS (registro A) a la IP del droplet.
DOMINIO=artani.ejemplo.mx
# Correo para los avisos de expiración de Let's Encrypt.
ACME_EMAIL=tu-correo@ejemplo.mx

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=artani
POSTGRES_DB=artani
# Genera una contraseña larga y única:  openssl rand -base64 32
# Si el valor incluye @ : / ? # o &, codifícalo en porcentaje (ver README.deploy.md).
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------
# Secreto de firma de los JWT. Genera uno propio:  openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Regional ---------------------------------------------------------------
TZ=America/Mexico_City
